  "pairs": [
    { "text": "text", "background": "bg", "description": "Body text on main background", "type": "text" },
    { "text": "text", "background": "surface", "description": "Body text on cards", "type": "text" },
    { "text": "text-muted", "background": "bg", "description": "Muted text on main background", "type": "text" },
