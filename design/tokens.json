      "sheetExit": { "duration": 250, "easing": "easeIn" },
      "tabSwitch": { "duration": 200, "easing": "easeInOut" },
      "listReorder": { "duration": 300, "easing": "spring" },
      "achievementUnlock": { "duration": 800, "easing": "spring" },
      "progressRing": { "duration": 500, "easing": "easeOut" }
    }
  },
